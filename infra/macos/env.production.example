# This file is copied to .env with mode 600. Replace every REQUIRED placeholder.
# Never commit the populated .env file.
WORKSPACE_MODE=sample
AGENT_BACKEND=model
NODE_ENV=production
PORT=8787
HOST=127.0.0.1

# The browser-facing origin. Use the Mac's specific Tailnet address or a loopback
# origin reached through an SSH tunnel. Do not use a wildcard interface.
PUBLIC_API_URL=http://100.80.94.16:8081
EXPO_PUBLIC_API_URL=http://100.80.94.16:8081
ALLOWED_ORIGINS=http://100.80.94.16:8081

DATA_DIR=/Volumes/p41-1tb/openmuse/data/app
TASK_WORKER_ENABLED=true

# REQUIRED in all modes. Generate/select this through the CopilotKit CLI.
CPK_INTELLIGENCE_API_KEY=REQUIRED

# REQUIRED for this private proxied sample deployment (24+ random characters).
OPENMUSE_ACCESS_KEY=REQUIRED

# Configure at least one real model and the corresponding server-only key.
MODEL=openai/REQUIRED_MODEL_ID
OPENAI_API_KEY=REQUIRED
# OPENAI_BASE_URL=http://127.0.0.1:REQUIRED/v1
# OPENMUSE_MODELS=[{"id":"fast","label":"Fast","model":"openai/REQUIRED_MODEL_ID","capabilities":["chat","tools"],"enabled":true}]
# ANTHROPIC_API_KEY=REQUIRED
# GOOGLE_API_KEY=REQUIRED
# OPENCODEX_BASE_URL=http://127.0.0.1:8788/v1
# OPENCODEX_API_KEY=REQUIRED

BROWSER_WORKER_URL=http://127.0.0.1:8790
WORKER_TOKEN=REQUIRED_32_OR_MORE_RANDOM_CHARACTERS
WORKER_DATA_DIR=/Volumes/p41-1tb/openmuse/data/browser-profiles
WORKER_HOST=127.0.0.1
PLAYWRIGHT_BROWSERS_PATH=/Volumes/p41-1tb/openmuse/caches/playwright

WEB_HOSTS=127.0.0.1,100.80.94.16
WEB_PORT=8081
WEB_ROOT=/Volumes/p41-1tb/openmuse/repo/apps/mobile/dist/web
API_PROXY_URL=http://127.0.0.1:8787

# Optional scoped Docker computer. Leave disabled unless its dedicated context
# exists; never point this deployment at an unrelated default Docker engine.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
COMPUTER_DEPLOYMENT_ID=openmuse-macmini
# DOCKER_CONTEXT=colima-openmuse

# Live Gmail/Calendar only (not needed for initial fictional sample data):
# WORKSPACE_MODE=live
# TOKEN_ENCRYPTION_KEY=REQUIRED_32_RANDOM_BYTES_BASE64
# GOOGLE_CLIENT_ID=REQUIRED
# GOOGLE_CLIENT_SECRET=REQUIRED
