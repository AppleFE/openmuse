# Copy to .env. Sample mode stays on localhost, uses fictional data, and needs
# no hosted thread service, cloud project, model account, or connector account.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# Local Ollama needs no API key. OLLAMA_BASE_URL is a bare origin; OpenMuse
# appends the SDK route. Install/pull the model separately before starting.
# MODEL=ollama/qwen3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional hosted providers:
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.
# Optional server-side model allowlist. IDs are stable UI values; model is the
# provider adapter string. This replaces the single MODEL without exposing keys.
# OPENMUSE_MODELS=[{"id":"local","label":"Local Qwen","model":"ollama/qwen3:4b","capabilities":["chat","tools","coding"],"enabled":true}]

# OpenCodex data-plane proxy (use an OpenCodex data key, never a management key).
# Include /v1 in the base URL; catalog entries use opencodex/<routed-model-id>.
# OPENCODEX_BASE_URL=http://127.0.0.1:8788/v1
# OPENCODEX_API_KEY=
# Fetch /models at startup and every 60 seconds; preserve configured profile IDs.
# Set false to use only the explicit OPENMUSE_MODELS list.
# OPENCODEX_MODEL_DISCOVERY=true

# Optional Jev policy layer and embedded pi coding runtime. Pi is enabled by
# default for allowlisted models with the coding capability and may be disabled
# per owner through PATCH /api/agent/runtime-settings. Jev remains disabled
# until configured and enabled; saved keys are encrypted and never returned.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# Pi reuses the server-only provider keys and OPENMUSE_MODELS allowlist above.
# Pi receives only reviewed OpenMuse tools, never host shell/filesystem tools,
# so set COMPUTER_ENABLED=true for coding that needs an isolated workspace.

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# OPENMUSE_AUTH_MODE=access-key  # default; set none to open the workspace without a login prompt
# In none mode, anyone who can reach the server can open the same workspace.
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional in sample mode when the local-only API is exposed through a private
# reverse proxy: setting OPENMUSE_ACCESS_KEY also protects the sample workspace.
# Keep an unprotected sample deployment on loopback only.

# Conversation threads, messages, tool results, tasks, and owner settings are
# stored by this OpenMuse server in DATABASE_URL (or embedded PGlite under
# DATA_DIR when DATABASE_URL is unset). No CopilotKit cloud key is required.
#
# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's managed runtime is not this raw AG-UI URL. See its adapter docs.

# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t openmuse-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
# Stable deployment name shared by API and worker; defaults to a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=my-openmuse
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-openmuse
